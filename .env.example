# Copy to .env.local for local development. Only public NEXT_PUBLIC_* values here,
# never secrets. On Vercel set the same names under Project Settings > Environment Variables.

# Spring Boot backend base URL (default: http://localhost:1121)
NEXT_PUBLIC_API_BASE_URL=http://localhost:1121

# Google OAuth Web client ID. Must be the SAME client ID as the backend's GOOGLE_CLIENT_ID
# (the backend checks the ID-token audience). Empty = Google button hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudinary unsigned upload for activity proof screenshots (preset stores files in srn-proofs).
# If either is empty, the screenshot upload is hidden and runners paste a proof link instead.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=kersuyxx
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=srn_proofs
